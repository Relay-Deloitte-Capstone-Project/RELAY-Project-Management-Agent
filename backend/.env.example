# Relay postgres (database/docker-compose.yml). Overrides the repo-root
# DATABASE_URL, which points at Prisma's sqlite file.
DATABASE_URL=postgresql://pm_user:pm_pass@localhost:5432/relay_db

# --- LLM ---
# Groq is the default provider: ~1s vs ~2.3s for the fastest usable Gemini
# model on this corpus, with better answers. The other is the automatic fallback.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# GOOGLE_GEMINI_API is this repo's name; GEMINI_API_KEY also works.
GOOGLE_GEMINI_API=
GEMINI_MODEL=gemini-3.5-flash

# Engagement whose chunks are searched by default
RELAY_ENGAGEMENT_ID=proj-001

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080
