# Relay postgres (database/docker-compose.yml). Overrides the repo-root
# DATABASE_URL, which points at Prisma's sqlite file.
DATABASE_URL=postgresql://pm_user:pm_pass@localhost:5432/relay_db

# --- LLM ---
# Ordered fallback chain — first provider with a key set becomes primary,
# the rest are automatic fallbacks. Any of: cerebras, gemini, groq, openrouter.
LLM_PROVIDER_CHAIN=cerebras,gemini,groq

# Cerebras free tier (https://cloud.cerebras.ai) — gpt-oss-120b gets
# 1M uncached tokens/day free; qwen-3.8-27b has a bigger request allowance.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# GOOGLE_GEMINI_API is this repo's name; GEMINI_API_KEY also works.
GOOGLE_GEMINI_API=
GEMINI_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional last-resort. Free ":free" models are ~50 req/day — keep it last.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- GitHub (code questions) ---
# Read access to the engagement repo. Lets Ask Project fetch a commit's diff
# live when asked about actual code; without it those questions fall back to
# describing the commit metadata already in the database.
GITHUB_TOKEN=

# --- Jira (sprint questions) ---
# Same values the analytics endpoints use.
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_ID=34

# Engagement whose chunks are searched by default
RELAY_ENGAGEMENT_ID=proj-001

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080
