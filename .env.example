# Postgres connection string. Local dev: the docker-compose instance in
# database/ (postgresql://pm_user:pm_pass@localhost:5432/relay_db).
# Production (Vercel): the pooled Neon connection string — see DEPLOY.md.
DATABASE_URL="postgresql://pm_user:pm_pass@localhost:5432/relay_db"
JWT_SECRET="min-32-character-random-string"
# URL of the FastAPI backend (Render in production, uvicorn locally).
VITE_ASK_API_URL=http://127.0.0.1:8001
